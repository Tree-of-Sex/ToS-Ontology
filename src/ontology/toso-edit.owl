AnnotationAssertion(dcterms:date <http://purl.obolibrary.org/obo/TOSO_0000023> "2025-02-17T11:14:18Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/TOSO_0000023> "It is common in angiosperms, and occurs in 10% of all plant species. GSSO:011868")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/TOSO_0000023> "monoecy"@en)
SubClassOf(<http://purl.obolibrary.org/obo/TOSO_0000023> <http://purl.obolibrary.org/obo/TOSO_0000021>)

