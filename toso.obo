property_value: dcterms:contributor https://orcid.org/0000-0003-1470-5450

[Term]
id: TOSO:0000016
name: Dioecy
def: "A sexual system of plants in which all individuals in a population are either female or male." []
is_a: TOSO:0000006 ! Sexual system
property_value: dcterms:contributor https://orcid.org/0000-0001-8949-7479
property_value: dcterms:contributor https://orcid.org/0000-0003-1148-631X
property_value: dcterms:contributor https://orcid.org/0000-0003-1470-5450

[Term]
id: TOSO:0000017
name: Gonochorism
def: "A sexual system in which anisogamous (different) gametes are produced in separate individuals." []
is_a: TOSO:0000006 ! Sexual system
property_value: dcterms:contributor https://orcid.org/0000-0001-8949-7479
property_value: dcterms:contributor https://orcid.org/0000-0003-1148-631X
property_value: dcterms:contributor https://orcid.org/0000-0003-1470-5450

[Term]
id: TOSO:0000018
name: Gynodioecy
def: "A sexual system in which females and hermaphroditic plants coexist in the same population." []
xref: GSSO:011873
is_a: TOSO:0000006 ! Sexual system
