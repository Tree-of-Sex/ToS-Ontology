[Term]
id: TOSO:0000015
name: Monoecy
def: "A sexual system in which plants have separate male and female flowers on the same plant." []
is_a: TOSO:0000006 ! Sexual system
property_value: dcterms:contributor https://orcid.org/0000-0001-8778-2110
property_value: dcterms:contributor https://orcid.org/0000-0001-8949-7479
