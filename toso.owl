    <!-- http://purl.obolibrary.org/obo/BFO_0000020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000020"/>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <obo:IAO_0000115>A dependent entity that inheres in a bearer by virtue of how the bearer is related to other entities</obo:IAO_0000115>
        <rdfs:label>quality</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0000001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A dependent entity that inheres in a bearer by virtue of how the bearer is related to other entities</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PATOC:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001241 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001241">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000001"/>
        <obo:IAO_0000115>A quality which inheres in a continuant.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>snap:Quality</oboInOwl:hasDbXref>
        <rdfs:label>physical object quality</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0001241"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A quality which inheres in a continuant.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PATOC:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001374 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001374">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001396"/>
        <obo:IAO_0000115>A cellular quality inhering in a bearer by virtue of the bearer&apos;s number of homologous sets of chromosomes in the nucleus or primary chromosome-containing compartment of the cell, each set essentially coding for all the biological traits of the organism.</obo:IAO_0000115>
        <rdfs:label>ploidy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0001374"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cellular quality inhering in a bearer by virtue of the bearer&apos;s number of homologous sets of chromosomes in the nucleus or primary chromosome-containing compartment of the cell, each set essentially coding for all the biological traits of the organism.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:http://en.wikipedia.org/wiki/Ploidy</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001396 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001396">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0070044"/>
        <obo:IAO_0000115>A monadic quality of continuant that exists at the cellular level of organisation.</obo:IAO_0000115>
        <rdfs:label>cellular quality</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0001396"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A monadic quality of continuant that exists at the cellular level of organisation.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PATOC:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0070044 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0070044">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001241"/>
        <obo:IAO_0000115>A quality of continuant that exist at the anatomical level of organisation and anything under it. This includes, but is not limited to, cells , tissues, and components.</obo:IAO_0000115>
        <rdfs:label>anatomical structure quality</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/toso/vocab/TOSO_0000001 -->

    <owl:Class rdf:about="http://w3id.org/toso/vocab/TOSO_0000001">
        <rdfs:label>Order</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/toso/vocab/TOSO_0000002 -->

    <owl:Class rdf:about="http://w3id.org/toso/vocab/TOSO_0000002">
        <rdfs:label>Family</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/toso/vocab/TOSO_0000003 -->

    <owl:Class rdf:about="http://w3id.org/toso/vocab/TOSO_0000003">
        <rdfs:label>Genus</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/toso/vocab/TOSO_0000004 -->

    <owl:Class rdf:about="http://w3id.org/toso/vocab/TOSO_0000004">
        <rdfs:label>Species</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/toso/vocab/TOSO_0000005 -->

    <owl:Class rdf:about="http://w3id.org/toso/vocab/TOSO_0000005">
        <obo:IAO_0000115>An organismal quality inhering in a bearer by virtue of the bearer&apos;s ability to produce new life or offspring.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PATO:0001434</oboInOwl:hasDbXref>
        <rdfs:label>Reproductive quality</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/toso/vocab/TOSO_0000006 -->

    <owl:Class rdf:about="http://w3id.org/toso/vocab/TOSO_0000006">
        <rdfs:subClassOf rdf:resource="http://w3id.org/toso/vocab/TOSO_0000005"/>
        <obo:IAO_0000115>Morphological pattern of sex allocation or distribution of male and female function across individuals in a species.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/41</obo:IAO_0000233>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-5370-2370"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1148-631X"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1470-5450"/>
        <rdfs:label>Sexual system</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/toso/vocab/TOSO_0000007 -->

    <owl:Class rdf:about="http://w3id.org/toso/vocab/TOSO_0000007">
        <rdfs:subClassOf rdf:resource="http://w3id.org/toso/vocab/TOSO_0000006"/>
        <obo:IAO_0000115>A sexual system where both male and female sex organs are present.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/37</obo:IAO_0000233>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/99</obo:IAO_0000233>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8949-7479"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-3515-729X"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-5984-6815"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-6085-3908"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-8378-8168"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1470-5450"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-4441-9615"/>
        <rdfs:label>Hermaphroditism</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/toso/vocab/TOSO_0000008 -->

    <owl:Class rdf:about="http://w3id.org/toso/vocab/TOSO_0000008">
        <rdfs:subClassOf rdf:resource="http://w3id.org/toso/vocab/TOSO_0000007"/>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/41</obo:IAO_0000233>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/99</obo:IAO_0000233>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1470-5450"/>
        <rdfs:label>Simultaneous hermaphroditism</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/toso/vocab/TOSO_0000009 -->

    <owl:Class rdf:about="http://w3id.org/toso/vocab/TOSO_0000009">
        <rdfs:subClassOf rdf:resource="http://w3id.org/toso/vocab/TOSO_0000007"/>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/41</obo:IAO_0000233>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/99</obo:IAO_0000233>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1470-5450"/>
        <rdfs:label>Sequential hermaphroditism</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/toso/vocab/TOSO_0000010 -->

    <owl:Class rdf:about="http://w3id.org/toso/vocab/TOSO_0000010">
        <rdfs:subClassOf rdf:resource="http://w3id.org/toso/vocab/TOSO_0000009"/>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/41</obo:IAO_0000233>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/99</obo:IAO_0000233>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1470-5450"/>
        <rdfs:label>bidirectional sex-change</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/toso/vocab/TOSO_0000011 -->

    <owl:Class rdf:about="http://w3id.org/toso/vocab/TOSO_0000011">
        <rdfs:subClassOf rdf:resource="http://w3id.org/toso/vocab/TOSO_0000009"/>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/41</obo:IAO_0000233>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/99</obo:IAO_0000233>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1470-5450"/>
        <rdfs:label>protandry</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/toso/vocab/TOSO_0000012 -->

    <owl:Class rdf:about="http://w3id.org/toso/vocab/TOSO_0000012">
        <rdfs:subClassOf rdf:resource="http://w3id.org/toso/vocab/TOSO_0000009"/>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/41</obo:IAO_0000233>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/99</obo:IAO_0000233>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1470-5450"/>
        <rdfs:label>protogyny</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/toso/vocab/TOSO_0000013 -->

    <owl:Class rdf:about="http://w3id.org/toso/vocab/TOSO_0000013">
        <rdfs:subClassOf rdf:resource="http://w3id.org/toso/vocab/TOSO_0000007"/>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/41</obo:IAO_0000233>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/99</obo:IAO_0000233>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1470-5450"/>
        <rdfs:label>Obligate hermaphroditism</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/toso/vocab/TOSO_0000014 -->

    <owl:Class rdf:about="http://w3id.org/toso/vocab/TOSO_0000014">
        <rdfs:subClassOf rdf:resource="http://w3id.org/toso/vocab/TOSO_0000007"/>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/41</obo:IAO_0000233>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/99</obo:IAO_0000233>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1470-5450"/>
        <rdfs:label>Facultative hermaphroditism</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/toso/vocab/TOSO_0000015 -->

    <owl:Class rdf:about="http://w3id.org/toso/vocab/TOSO_0000015">
        <rdfs:subClassOf rdf:resource="http://w3id.org/toso/vocab/TOSO_0000006"/>
        <obo:IAO_0000115>A sexual system in which plants have separate male and female flowers on the same plant.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/14</obo:IAO_0000233>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/37</obo:IAO_0000233>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/41</obo:IAO_0000233>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8778-2110"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8949-7479"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-6085-3908"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1148-631X"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1470-5450"/>
        <rdfs:label>Monoecy</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/toso/vocab/TOSO_0000016 -->

    <owl:Class rdf:about="http://w3id.org/toso/vocab/TOSO_0000016">
        <rdfs:subClassOf rdf:resource="http://w3id.org/toso/vocab/TOSO_0000006"/>
        <obo:IAO_0000115>A sexual system of plants in which all individuals in a population are either female or male.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/25</obo:IAO_0000233>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/37</obo:IAO_0000233>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/41</obo:IAO_0000233>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8949-7479"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1148-631X"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1470-5450"/>
        <rdfs:label>Dioecy</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/toso/vocab/TOSO_0000017 -->

    <owl:Class rdf:about="http://w3id.org/toso/vocab/TOSO_0000017">
        <rdfs:subClassOf rdf:resource="http://w3id.org/toso/vocab/TOSO_0000006"/>
        <obo:IAO_0000115>A sexual system in which anisogamous (different) gametes are produced in separate individuals.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/25</obo:IAO_0000233>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/41</obo:IAO_0000233>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8949-7479"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1148-631X"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1470-5450"/>
        <rdfs:label>Gonochorism</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/toso/vocab/TOSO_0000018 -->

    <owl:Class rdf:about="http://w3id.org/toso/vocab/TOSO_0000018">
        <rdfs:subClassOf rdf:resource="http://w3id.org/toso/vocab/TOSO_0000006"/>
        <obo:IAO_0000115>A sexual system in which females and hermaphroditic plants coexist in the same population.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri"> https://github.com/Tree-of-Sex/ToS-Ontology/issues/12</obo:IAO_0000233>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/37</obo:IAO_0000233>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyUri">https://github.com/Tree-of-Sex/ToS-Ontology/issues/41</obo:IAO_0000233>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-6085-3908"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-6789-6564"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1148-631X"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1470-5450"/>
        <oboInOwl:hasDbXref>GSSO:011873</oboInOwl:hasDbXref>
        <rdfs:label>Gynodioecy</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/toso/vocab/TOSO_0000019 -->

    <owl:Class rdf:about="http://w3id.org/toso/vocab/TOSO_0000019">
