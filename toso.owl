        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/toso/releases/2026-05-15/toso.owl"/>
        <dcterms:description xml:lang="en">The Tree of Sex ontology covers any trait related to reproduction included in the Tree of Sex database</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/unspecified"/>
        <dcterms:title>Tree of Sex ontology</dcterms:title>
        <owl:versionInfo>2026-05-15</owl:versionInfo>
    </owl:Ontology>
    


